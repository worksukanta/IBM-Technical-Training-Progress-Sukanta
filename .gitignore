# ==============================================================================
# Node.js, Express & Angular (Frontend/Backend JavaScript/TypeScript)
# ==============================================================================
# Dependencies (Never commit these!)
node_modules/
jspm_packages/
web_modules/

# TypeScript & Angular Build Outputs
dist/
out-files/
.angular/
.nx/

# Debug and Runtime Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Firebase or Hosting deployment caches
.firebase/

# Local Environment variables (contains private keys/passwords)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Optional TypeScript/Angular cache records
.tsbuildinfo
.eslintcache

# ==============================================================================
# Java, Maven & Build Tools (Existing)
# ==============================================================================
*.class
target/
.mvn/wrapper/maven-wrapper.jar

# ==============================================================================
# IDEs and System Files (Existing + Optimized)
# ==============================================================================
.vscode/
.classpath
.project
.settings/
.idea/
*.iml

# OS generated files
.DS_Store
Thumbs.db

# General Logs & Temporary Files
*.log
*.tmp
*.temp
*.swp
