<project xmlns="http://apache.org" xmlns:xsi="http://w3.org"
  xsi:schemaLocation="http://apache.org http://apache.org">
  <modelVersion>4.0.0</modelVersion>
  
  <groupId>com.school</groupId>
  <artifactId>SpringRevision</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>SpringRevision</name>
  <url>http://apache.org</url>

  <!-- 1. The Parent POM manages your Spring Boot ecosystem and versioning -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <properties>
    <!-- Spring Boot 4.1.0 requires a minimum of Java 17 up to Java 26 -->
    <java.version>17</java.version> 
  </properties>

  <dependencies>
    <!-- 2. Core Spring Boot Web starter handles @RestController, @GetMapping, and Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 3. Modern Spring Boot testing framework (replaces old standalone junit 3.8) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <scope>test</scope>
  </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- 4. Allows packaging your app into an executable fat JAR with 'mvn package' -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
