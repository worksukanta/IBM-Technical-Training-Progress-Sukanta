{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "esnext",
    "strict": true,
    
    "verbatimModuleSyntax": false, 
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
